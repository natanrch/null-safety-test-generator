{
    "name": "natan/null-safety-test-generator",
    "description": "Gerador automático de testes para detectar erros causados por valores null em aplicações Laravel.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Natan\\NullSafetyTestGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Natan\\NullSafetyTestGenerator\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "nikic/php-parser": "^5.8"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Natan\\NullSafetyTestGenerator\\NullSafetyServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    }
}
